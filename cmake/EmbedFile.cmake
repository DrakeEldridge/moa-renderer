# Turns a file into a C++ source with its bytes in an array, so the GPU programs (PTX) live
# inside the library and plugins don't need to find a separate .ptx file at runtime.
# Usage: cmake -DINPUT=file.ptx -DOUTPUT=EmbeddedPtx.cpp -DSYMBOL=moaEmbeddedPtx -P EmbedFile.cmake
# SPDX-License-Identifier: Apache-2.0
file(READ "${INPUT}" HEX HEX)
string(LENGTH "${HEX}" HEX_LEN)
math(EXPR SIZE "${HEX_LEN} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
# Line breaks every 32 bytes keep the generated file readable for compilers and editors.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" BYTES "${BYTES}")
file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedFile.cmake from ${INPUT}. Do not edit.\n"
"#include <cstddef>\n"
"namespace moa {\n"
"extern const unsigned char ${SYMBOL}[] = {\n${BYTES}\n0x00};\n"
"extern const std::size_t ${SYMBOL}Size = ${SIZE};\n"
"}  // namespace moa\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
